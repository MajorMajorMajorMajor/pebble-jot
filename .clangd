# clangd's fallback command (no compile_commands.json) runs from each
# source file's directory. Waf/Pebble adds -Isrc/c to the *build*, but
# clangd doesn't inherit that flag, causing cascading unknown-type
# diagnostics after it fails to find headers such as ui/legend_geometry.h.
#
# Keep these relative to the *source directory* for fallback mode.
# If a real compile_commands.json exists, its SDK include flags still apply.
CompileFlags:
  Remove:
    - -Wno-error=zero-length-bounds
    - -Wno-error=builtin-declaration-mismatch
    - -Wno-error=format-truncation

---
If:
  PathMatch: src/c/[^/]+\.[ch]
CompileFlags:
  Add: [-std=c11, -I.]

---
If:
  PathMatch: src/c/(ui|jot|keyboard)/[^/]+\.[ch]
CompileFlags:
  Add: [-std=c11, -I..]

---
If:
  PathMatch: tests/behavior/[^/]+\.[ch]
CompileFlags:
  Add: [-std=c11, -I../../src/c, -I../fake]
